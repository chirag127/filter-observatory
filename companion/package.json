    "zip:firefox": "wxt zip -b firefox",
    "postinstall": "wxt prepare",
    "compile": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts"
  },
  "devDependencies": {
    "@types/jsdom": "30.0.0",
    "@types/node": "26.6.6",
    "fake-indexeddb": "6.2.8",
    "jsdom": "31.0.1",
    "typescript": "7.0.2",
    "wxt": "0.21.5"
  }
